# ════════════════════════════════════════════════════════════════════════════
#  Gold AI Trading Bot — contoh konfigurasi
#  Salin file ini jadi `.env`  →  `cp .env.example .env`  lalu isi nilainya.
#  Cara termudah: jalankan wizard interaktif  →  `python setup.py`
# ════════════════════════════════════════════════════════════════════════════

# ── Binance API (binance.com → API Management) ──────────────────────────────
#   PAPER: read-only sudah cukup.
#   LIVE : WAJIB aktifkan "Enable Futures". Disarankan batasi IP whitelist.
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_secret_here

# ── LLM — "otak" bot (BEBAS GANTI MODEL / PROVIDER) ─────────────────────────
#   Atur 4 baris di bawah. Provider "openai" = semua endpoint OpenAI-compatible.
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o
# LLM_MAX_TOKENS=1200
# LLM_TEMPERATURE=0.3
#
# Contoh provider lain (ganti 4 baris di atas — aktifkan SALAH SATU):
#   OpenRouter : LLM_PROVIDER=openai  LLM_BASE_URL=https://openrouter.ai/api/v1            LLM_MODEL=anthropic/claude-3.7-sonnet
#   Groq       : LLM_PROVIDER=openai  LLM_BASE_URL=https://api.groq.com/openai/v1          LLM_MODEL=llama-3.3-70b-versatile
#   DeepSeek   : LLM_PROVIDER=openai  LLM_BASE_URL=https://api.deepseek.com                LLM_MODEL=deepseek-chat
#   Gemini     : LLM_PROVIDER=openai  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   LLM_MODEL=gemini-2.0-flash
#   NVIDIA NIM : LLM_PROVIDER=openai  LLM_BASE_URL=https://integrate.api.nvidia.com/v1     LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
#   Ollama     : LLM_PROVIDER=openai  LLM_BASE_URL=http://localhost:11434/v1               LLM_MODEL=llama3.1    LLM_API_KEY=ollama
#   Claude     : LLM_PROVIDER=anthropic                                                    LLM_MODEL=claude-opus-4-5   LLM_API_KEY=your_anthropic_key

# ── NewsAPI (newsapi.org — free tier OK). Opsional; kosong = lewati berita. ──
NEWS_API_KEY=your_newsapi_key_here

# ── Telegram (opsional) — notifikasi + remote control /pause /close /status ──
#   Token  : dari @BotFather.   Chat ID : dari @userinfobot.
#   Dikosongkan = fitur Telegram nonaktif (bot tetap jalan normal).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Parameter Trading ───────────────────────────────────────────────────────
SYMBOL=XAUUSDT              # pair Binance Futures (alt: PAXGUSDT)
TRADE_USDT=50              # modal per trade (USDT)
LEVERAGE=5                 # leverage (x)
STOP_LOSS_PCT=0.005        # 0.5% — fallback SL bila LLM tak kasih level
TAKE_PROFIT_PCT=0.015      # 1.5% — RR 1:3
SCAN_INTERVAL_SEC=60       # scan market tiap N detik

# ── Filter sinyal & eksekusi ─────────────────────────────────────────────────
MIN_CONFIDENCE=65          # hanya eksekusi sinyal confidence >= ini (0-100)
MIN_QUALITY=A+,A           # kualitas trade yang boleh dieksekusi (pisah koma)
MIN_RR=1.2                 # tolak setup Risk:Reward (entry→TP1) di bawah ini. 0 = off
SLIPPAGE_BPS=2             # simulasi slippage/spread paper (basis poin). 0 = isi ideal

# ── MODE: paper vs live ──────────────────────────────────────────────────────
#   True  = simulasi (TIDAK ada order nyata) ← default AMAN, untuk uji coba.
#   False = LIVE, kirim order asli ke Binance. Tes di Testnet/size kecil dulu!
PAPER_TRADING=True

# ── Circuit Breakers (safety net harian) ────────────────────────────────────
MAX_TRADES_PER_DAY=10      # 0 = tak terbatas
MAX_DAILY_LOSS_USDT=50     # stop buka posisi bila rugi harian tembus ini. 0 = off
LOSS_COOLDOWN_TRADES=3     # rugi beruntun N kali → jeda sisa hari
MAX_SL_DISTANCE_PCT=0.02   # tolak setup dgn SL > 2% dari entry. 0 = off
USE_CLOSED_CANDLES=True    # analisa hanya candle yang sudah close (anti-repaint)

# ── Self-learning / evaluasi harian otomatis ────────────────────────────────
AUTO_DAILY_EVAL=True       # evaluasi performa tiap tengah malam (waktu lokal)
EVAL_TZ_OFFSET_HOURS=7     # 7 = WIB
